# ── Karmavitta ArcFace Face Service — High-Level Production Config ──
# Copy to .env per server (never commit). See face_service/docs/DEPLOYMENT.md
# bench start → face_service/scripts/bench_start.sh auto-creates .venv + .env

# ── Service / Network ──
FACE_SERVICE_API_KEY=change-me-face-service-key  # MUST change: 32+ random chars, must match Desk → Face Attendance Settings → Face Service API Key
FACE_SERVICE_PORT=8090
FACE_SERVICE_HOST=127.0.0.1
CORS_ORIGINS=["*"]  # Production: restrict, e.g. ["https://erp.example.com"]

# ── Model — InsightFace ArcFace (verify commercial license) ──
MODEL_NAME=ArcFace
MODEL_VERSION=insightface-buffalo_l-1.0
INSIGHTFACE_MODEL_PACK=buffalo_l  # auto-downloaded on first run
EMBEDDING_DIMENSION=512
TEMPLATE_VERSION=arcface-1
DET_SIZE=640,640
CTX_ID=-1  # -1=CPU, 0=GPU 0 (needs requirements-gpu.txt + CUDA)
ONNX_PROVIDER=CPUExecutionProvider  # CUDAExecutionProvider for GPU

# ── Matching — ArcFace cosine (calibrate on your data; service is authoritative) ──
FACE_MATCH_THRESHOLD=0.40      # accept verify if score ≥ this
FACE_DUPLICATE_THRESHOLD=0.45  # reject register if score ≥ this vs anyone else
FACE_MATCH_MARGIN=0.05         # ambiguous if top-2 gap < this

# ── Quality / Image — reject bad captures early ──
MAX_IMAGE_BYTES=5242880        # 5 MB
MIN_IMAGE_SIDE=80
MAX_IMAGE_SIDE=4096
MIN_FACE_PIXELS=80
BLUR_VARIANCE_MIN=40.0
RATE_LIMIT_PER_MINUTE=120      # per-IP
