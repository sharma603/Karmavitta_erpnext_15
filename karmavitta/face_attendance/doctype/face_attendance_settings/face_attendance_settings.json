   "fieldtype": "Select",
   "label": "Similarity Metric",
   "options": "cosine"
  },
  {
   "fieldname": "column_break_biometric",
   "fieldtype": "Column Break"
  },
  {
   "default": "0.72",
   "description": "Reject registration when cosine similarity vs ANY other employee is ≥ this. FaceNet: use ~0.70–0.78. Too low (e.g. 0.50) falsely blocks different people.",
   "fieldname": "face_duplicate_threshold",
   "fieldtype": "Float",
   "label": "Face Duplicate Threshold",
   "precision": "3"
  },
  {
   "default": "0.70",
   "description": "Accept attendance verification when cosine ≥ this. FaceNet: use ~0.70–0.78. Values below 0.68 are floored automatically to avoid wrong-person matches.",
   "fieldname": "face_match_threshold",
   "fieldtype": "Float",
   "label": "Face Match Threshold",
   "precision": "3"
  },
  {
   "default": "0.50",
   "description": "Same employee may update without admin if new face cosine vs own template ≥ this; otherwise require re-registration approval.",
   "fieldname": "face_same_person_update_threshold",
   "fieldtype": "Float",
   "label": "Same-Person Update Threshold",
   "precision": "3"
  },
  {
   "default": "none",
   "description": "Modular PAD/liveness. Blink/head-turn alone are not strong anti-spoofing.",
   "fieldname": "liveness_provider",
   "fieldtype": "Select",
   "label": "Liveness Provider",
   "options": "none\nquality_multipose\nexternal"
  },
  {
